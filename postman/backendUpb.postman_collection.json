{
  "info": {
    "name": "backendUpb - Productos",
    "description": "CRUD de productos (Express + PostgreSQL). La colección apunta por defecto al backend local.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "description": "Backend local" },
    { "key": "id", "value": "2", "description": "Id del producto a consultar, actualizar o eliminar" }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/"
      }
    },
    {
      "name": "Listar productos",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/productos"
      }
    },
    {
      "name": "Buscar productos por nombre",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/productos?nombre=prueba"
      }
    },
    {
      "name": "Obtener producto por id",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/productos/{{id}}"
      }
    },
    {
      "name": "Crear producto",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "    pm.collectionVariables.set('id', pm.response.json().id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"nombre\": \"Laptop\",\n    \"precio\": 1500,\n    \"stock\": 5\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/productos"
      }
    },
    {
      "name": "Actualizar producto",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"precio\": 1350,\n    \"stock\": 10\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/productos/{{id}}"
      }
    },
    {
      "name": "Eliminar producto",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/productos/{{id}}"
      }
    },
    {
      "name": "Crear producto inválido (400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"precio\": -10\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/productos"
      }
    }
  ]
}
